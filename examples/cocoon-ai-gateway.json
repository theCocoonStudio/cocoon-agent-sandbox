{
  "version": 1,
  "sandbox": {
    "repo": "theCocoonStudio/cocoon-agent-sandbox",
    "ref": "main"
  },
  "command": {
    "install": true
  },
  "image": "example-sandbox",
  "account": "example-org",
  "workspace": {
    "repo": "example-org/example-app"
  },
  "clones": [
    "example-org/example-notes"
  ],
  "profiles": [
    "research"
  ],
  "agents": {
    "claude": {
      "app_id": "100001",
      "key": "~/example-claude.private-key.pem",
      "bot": "example-claude[bot]",
      "bot_id": "200001",
      "container": "example-sandbox",
      "workspace_volume": "example-workspace",
      "config_volume": "example-claude-config:/home/node/.claude",
      "env": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude",
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "gateway": {
        "cert": "~/.config/cocoon/gateway/claude.crt",
        "key": "~/.config/cocoon/gateway/claude.key",
        "token": "~/.config/cocoon/gateway/claude.token",
        "model": true
      }
    },
    "gemini": {
      "app_id": "100002",
      "key": "~/example-gemini.private-key.pem",
      "bot": "example-gemini[bot]",
      "bot_id": "200002",
      "container": "example-sandbox-gemini",
      "workspace_volume": "example-workspace-gemini",
      "config_volume": "example-gemini-config:/home/node/.gemini",
      "tokens_file": "~/.tokens",
      "env": {},
      "gateway": {
        "cert": "~/.config/cocoon/gateway/gemini.crt",
        "key": "~/.config/cocoon/gateway/gemini.key",
        "token": "~/.config/cocoon/gateway/gemini.token",
        "model": false
      }
    }
  },
  "gateway": {
    "domain": "gw.example.com",
    "address": "203.0.113.10",
    "upstreams": [
      "github",
      "git",
      "npm",
      "anthropic",
      "arxiv",
      "export-arxiv"
    ],
    "ca": "~/.config/cocoon/gateway/root.crt"
  }
}
